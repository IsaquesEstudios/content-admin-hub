<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Sitemap do Google (redirect para o gerador dinâmico)
  RewriteRule ^sitemap\.xml$ https://fuagnnrpnjpnrvudmtie.supabase.co/functions/v1/sitemap [R=301,L]

  # SPA fallback
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
